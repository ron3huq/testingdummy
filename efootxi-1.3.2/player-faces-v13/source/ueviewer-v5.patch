+
+void FArchive::ByteOrderSerialize(void *data, int size)
+{
+	PROFILE_IF(size >= 1024);
+	guard(FArchive::ByteOrderSerialize);
+
+	Serialize(data, size);
+	if (!ReverseBytes || size <= 1) return;
+
+	assert(IsLoading);
+	byte *p1 = (byte*)data;
+	byte *p2 = p1 + size - 1;
+	while (p1 < p2)
+	{
+		Exchange(*p1, *p2);
+		p1++;
+		p2--;
+	}
+
+	unguard;
+}
