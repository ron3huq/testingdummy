-		Ar << b;
-		int sign  = b & 0x80;	// sign bit
-		int shift = 6;
-		int r     = b & 0x3F;
-		if (b & 0x40)			// has 2nd byte
-		{
-			do
-			{
-				Ar << b;
-				r |= (b & 0x7F) << shift;
