+	va_start(argptr, fmt);
+	char buf[4096];
+	int len = vsnprintf(ARRAY_ARG(buf), fmt, argptr);
+	va_end(argptr);
+	if (len < 0 || len >= sizeof(buf) - 1) exit(1);
+	Serialize(buf, len);
+}
