-int FFileReader::Tell() const
-{
-	assert((BufferPos >> 32) == 0);
-	return (int)BufferPos + LocalReadPos;
-}
-
-int64 FFileReader::Tell64() const
-{
-	return BufferPos + LocalReadPos;
-}
