-struct DummyItem	// non-serializeable
-{
-	friend FArchive& operator<<(FArchive &Ar, DummyItem &Item)
-	{
-		return Ar;
-	}
-};
-
-void SkipFixedArray(FArchive &Ar, int ItemSize)
-{
-	TArray<DummyItem> DummyArray;
-	Ar << DummyArray;
-	Ar.Seek(Ar.Tell() + DummyArray.Num() * ItemSize);
