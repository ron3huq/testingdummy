-			assert(v);
-			while (v)
-			{
-				b = v & 0x7F;
-				v >>= 7;
-				if (v)
-					b |= 0x80;	// has more bytes
-				Ar << b;
-			}
-		}
-	}
-	return Ar;
-}
-
-
