package org.efootballrevival.runtimeprobe;
import android.app.*;import android.widget.*;import org.json.*;import java.util.*;
public final class TransferFootEditor{
 public static void open(Activity a,JSONObject req,String id){new Thread(()->{try{JSONObject r=new JSONObject(req.toString()).put("player_id",id);JSONObject d=new JSONObject(EmbeddedGateway.manage(a,"ui712_transfer_traits_get",r.toString()));a.runOnUiThread(()->show(a,r,d));}catch(Exception e){error(a,e);}},"TransferFootLoad").start();}
 private static void error(Activity a,Exception e){a.runOnUiThread(()->new AlertDialog.Builder(a).setMessage(e.getMessage()).setPositiveButton("OK",null).show());}
 private static Spinner field(Activity a,LinearLayout l,String label,String[] choices,int value){TextView t=new TextView(a);t.setText(label);l.addView(t);Spinner s=new Spinner(a);s.setAdapter(new ArrayAdapter<String>(a,android.R.layout.simple_spinner_dropdown_item,choices));s.setSelection(value);l.addView(s);return s;}
 private static void show(Activity a,JSONObject req,JSONObject d){try{
 if(a.isFinishing())return;JSONObject foot=d.getJSONObject("foot"),pos=d.getJSONObject("positions");JSONArray names=d.getJSONArray("position_choices");String[] roles=new String[names.length()];for(int i=0;i<roles.length;i++)roles[i]=names.getString(i);
 LinearLayout root=new LinearLayout(a);root.setOrientation(1);root.setPadding(24,12,24,12);ScrollView scroll=new ScrollView(a);scroll.addView(root);
 Spinner dominant=field(a,root,"Dominant foot",new String[]{"Right","Left"},foot.getInt("43")),use=field(a,root,"Weak foot usage",new String[]{"0 · Rarely","1","2","3 · Regularly"},foot.getInt("42")),accuracy=field(a,root,"Weak foot accuracy",new String[]{"0 · Low","1","2","3 · High"},foot.getInt("45")),primary=field(a,root,"Primary position",roles,pos.getInt("0"));Spinner[] prof=new Spinner[13];for(int i=0;i<13;i++)prof[i]=field(a,root,roles[i]+" proficiency",new String[]{"0 · None","1 · Partial","2 · Full"},pos.getInt(""+(i+1)));
 AlertDialog dialog=new AlertDialog.Builder(a).setTitle(d.optString("name")+" · Foot & Positions").setView(scroll).setNegativeButton("Cancel",null).setPositiveButton("Save",null).create();dialog.show();dialog.getWindow().setLayout(-1,(int)(a.getResources().getDisplayMetrics().heightPixels*.88));dialog.getButton(-1).setOnClickListener(v->{try{
 JSONObject nextFoot=new JSONObject().put("43",dominant.getSelectedItemPosition()).put("42",use.getSelectedItemPosition()).put("45",accuracy.getSelectedItemPosition()),nextPos=new JSONObject().put("0",primary.getSelectedItemPosition());for(int i=0;i<13;i++)nextPos.put(""+(i+1),prof[i].getSelectedItemPosition());JSONObject save=new JSONObject(req.toString()).put("foot",nextFoot).put("positions",nextPos);dialog.getButton(-1).setEnabled(false);new Thread(()->{try{JSONObject result=new JSONObject(EmbeddedGateway.manage(a,"ui712_transfer_traits_apply",save.toString()));if(!result.optBoolean("saved"))throw new Exception(result.optString("error","Save failed"));a.runOnUiThread(()->{dialog.dismiss();Toast.makeText(a,"Saved · applies on next game launch",Toast.LENGTH_LONG).show();});}catch(Exception e){a.runOnUiThread(()->dialog.getButton(-1).setEnabled(true));error(a,e);}},"TransferFootSave").start();}catch(Exception e){error(a,e);}});
 }catch(Exception e){error(a,e);}}
}
